# Copy to .env and fill in. Variables already set in your shell win over .env.
# See README for provider examples (OpenAI, Claude, DeepSeek, OpenRouter, Ollama).

# Required for non-dry runs
LLM_API_KEY=
# Recommended default for FixBrief AI (OpenAI Chat Completions).
# gpt-5-mini shuts down on 2026-12-11; OpenAI's replacement is gpt-6.1-terra.
LLM_MODEL=gpt-6.1-terra

# openai (default) or anthropic
LLM_PROVIDER=openai

# API root. OpenAI default below. Override for DeepSeek/OpenRouter/Ollama
# (e.g. https://api.deepseek.com, https://openrouter.ai/api/v1).
# If you switch back to OpenAI, restore this URL — a leftover override sends
# gpt-6.1-terra requests to the wrong host.
LLM_BASE_URL=https://api.openai.com/v1

# Max completion tokens per call (OpenAI-compatible and Anthropic). Default 8192.
# LLM_MAX_OUTPUT_TOKENS=8192

# Per-request timeout in ms (default 600000 = 10 minutes). Raise for slow thinking models.
# LLM_REQUEST_TIMEOUT_MS=600000

# DeepSeek thinking mode: disabled | enabled. DeepSeek base URLs default to disabled.
# LLM_THINKING=disabled

# Sampling temperature (default 0). gpt-5, gpt-6, and o-series models omit it (including gpt-6.1-terra).
LLM_TEMPERATURE=none

# Independent review passes for agreement scoring (1-5, default 2). Later runs use CONSISTENCY_TEMPERATURE.
# Agreement adjusts confidence; critical/high that clear the floor still publish as one-offs.
# CONSISTENCY_RUNS=2
# CONSISTENCY_TEMPERATURE=0.4

# Confidence floor for inline comments (0..1). Inline also requires severity critical or high.
# Fix-brief medium findings (≥ FIX_BRIEF_MEDIUM_CONFIDENCE) are summarised in the overview;
# weaker findings stay in the workflow job summary (enable debug-artifacts to upload findings.json).
# MINIMUM_CONFIDENCE=0.85

# Finding categories to keep (comma-separated), or all.
# Valid: security, quality, maintainability, performance, architecture, testing,
# documentation, compliance. Style/lint nits stay out of scope either way.
# CATEGORIES=all
# CATEGORIES=security,compliance

# Max annotated chars packed per API call (default 100000).
# BATCH_CHARS=100000
# Max chars per file piece before hunk-splitting (default 20000). Large files are split even
# when under BATCH_CHARS, and split parts are not packed back together.
# PIECE_CHARS=20000
